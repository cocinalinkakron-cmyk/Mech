# Copia este archivo como .env y rellena los valores.

# PIN del panel del taller
ADMIN_PIN=1234
# PORT=3000

# --- Supabase (opcional) ---
# Si los dejas vacíos, los datos se guardan en data/db.json.
# Supabase → Project Settings → API (o "API Keys")
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave SECRETA (sb_secret_… o la "service_role"). Nunca la pongas en el navegador ni la subas a git.
SUPABASE_SECRET_KEY=
